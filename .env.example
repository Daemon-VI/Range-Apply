# CareerOS Configuration
#
# Copy to .env and fill in what you need. Every setting below is read by
# app/config.py (pydantic-settings); anything left unset uses the default
# shown here. See docs/DEVELOPMENT.md for the required setup steps
# (`alembic upgrade head` before first run).

# --- Application ---

APP_NAME=CareerOS
APP_ENV=development
# Off by default: DEBUG leaks internals through error responses and echoes SQL.
DEBUG=false
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
# "solo" = everything on your own machine (default). "hosted" = the free-tier
# topology (Supabase + Render + GitHub Actions + browser extension). Same code.
DEPLOYMENT_MODE=solo
# Every candidate-side row is scoped to a tenant. Solo mode uses one tenant.
DEFAULT_TENANT_ID=default

# --- Security ---

# Guards every write endpoint (X-API-Key header) AND the dashboard (?key=...,
# then an HttpOnly cookie). Unset is tolerated ONLY when APP_ENV is
# development/dev/test (a warning is logged once); outside those, an unset
# key makes writes return 503 and the dashboard unreachable. Set this before
# any real deployment.
# API_KEY=change-me-to-a-long-random-value

# --- Database ---

# SQLite for zero-install local dev; PostgreSQL for anything shared
# (pip install -e ".[postgres]"). No code change required either way.
# `docker compose up -d` starts a local Postgres matching the second line.
DATABASE_URL=sqlite:///./careeros.db
# DATABASE_URL=postgresql://careeros:careeros@localhost:5432/careeros
# Connection pool (PostgreSQL only). Keep small on free tiers: Supabase's
# direct-connection cap is low and idle connections get dropped.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE_SECONDS=1800

# --- Career data (Phase 1) ---

# Path to the Career Brain's structured seed data (relative to project root).
CAREER_DATA_PATH=data/career_seed.json

# --- Firecrawl (Phase 2, optional) ---
#
# Public-web fallback for postings outside the Greenhouse/Lever/Ashby APIs.
# Never required for the ATS path and never used for application submission.

# FIRECRAWL_API_KEY=fc-your-api-key-here
FIRECRAWL_API_URL=https://api.firecrawl.dev/v1/scrape
# Requests per minute.
FIRECRAWL_RATE_LIMIT=5

# --- AI Gateway (Blueprint Phase 8b) ---
#
# Every model call in CareerOS goes through one gateway (app/ai). AI is an
# optional accelerator: with AI_ENABLED=false (the default) discovery,
# matching, admission, preparation, execution and verification make zero AI
# calls and every caller uses its deterministic path. Nothing becomes active
# because a key happens to be set.
AI_ENABLED=false
# "stub" (offline), "gemini" (Google AI Studio free tier), "ollama" (local model server)
AI_PROVIDER=stub
# Optional model override for the provider (Gemini defaults to GEMINI_MODEL).
AI_MODEL=
AI_TIMEOUT_SECONDS=20
# Provider calls allowed per scope (one discovery run, one preparation package).
AI_MAX_CALLS_PER_RUN=50
AI_MAX_OUTPUT_TOKENS=1024
# Versioned answer cache (JSON files; never expires by time). Empty = in-memory.
AI_CACHE_ENABLED=true
AI_CACHE_DIR=.cache/ai
# Hosted providers allowed to see candidate-side text (L2 polish). Local
# providers are always allowed; add "gemini" here only if you accept that.
AI_CANDIDATE_DATA_PROVIDERS=ollama
AI_OLLAMA_URL=http://127.0.0.1:11434
AI_OLLAMA_MODEL=llama3.2
# Durable per-call accounting rows (ai_usage): metadata only, never prompts.
AI_USAGE_PERSIST=true
# Per-candidate AI settings (enabled, provider, limits) live on the
# application policy: /dashboard/policy or PUT /api/v1/ai/config.

# --- Signal Inbox (Blueprint Phase 10) ---

# How much normalized, credential-redacted text of a supplied message is
# stored (never raw HTML, headers, cookies or tokens; no mailbox is read).
SIGNAL_EXCERPT_CHARS=2000
# POST /api/v1/signals/purge-excerpts drops the excerpt of settled signals
# older than this; hashes, classification, attribution and outcomes stay.
SIGNAL_EXCERPT_RETENTION_DAYS=180

# Legacy alias (Phase 2): LLM_PROVIDER=gemini still selects Gemini as the
# provider but never turns AI on; use AI_PROVIDER.
LLM_PROVIDER=stub
# Required only if the provider is gemini
# GEMINI_API_KEY=your-gemini-api-key-here
# Configurable on purpose: Google retires model aliases on its own schedule,
# so pinning a model id in code would break silently later.
GEMINI_MODEL=gemini-2.0-flash

# --- Discovery pipeline (Phase 2) ---

# Max boards processed concurrently by run_many() (e.g. the batch/cron endpoint).
DEFAULT_DISCOVERY_CONCURRENCY=3
# Bounded retries for transient source errors (429/5xx), exponential backoff.
MAX_RETRIES=3
RETRY_BACKOFF_BASE=2.0
# Per-source outbound request budget, enforced by the shared token-bucket limiter.
SOURCE_RATE_LIMIT_PER_MINUTE=30
# Per-request timeout (seconds) for source adapters.
SOURCE_REQUEST_TIMEOUT=15.0
# A discovery run still marked "running" after this many minutes is treated
# as interrupted (crash/restart recovery).
STALE_RUN_TIMEOUT_MINUTES=60
# Skip the stale-job-closure sweep when a run failed more than this fraction
# of its jobs (the observed set is considered incomplete).
CLOSURE_MAX_FAILURE_RATIO=0.25
# Random extra fraction added to each retry backoff so retries de-synchronise.
RETRY_JITTER_RATIO=0.25
# Per-source circuit breaker: after this many consecutive terminal failures
# the source is skipped for this many seconds instead of hammered.
SOURCE_CIRCUIT_FAILURE_THRESHOLD=3
SOURCE_CIRCUIT_OPEN_SECONDS=600
# Default polling interval (minutes) for a tracked board; failing boards back
# off automatically (doubling per failure, max 24h). See /dashboard/sources.
DISCOVERY_DEFAULT_POLL_MINUTES=360
# Comma-separated tenants that get a DISCOVERED candidate_opportunities row
# for every new opportunity after a run (cheap inserts; no scoring).
DISCOVERY_PROJECT_TENANTS=default
DISCOVERY_MAX_ERRORS_STORED=50

# --- Matching engine (Phase 3) ---

# Bump this when scoring weights/logic change; stored on every match so an
# old score is never silently reinterpreted under a new policy.
MATCH_POLICY_VERSION=v1

# Optional / off by default. CPU-only sentence-transformers similarity as the
# lowest-priority skill-matching layer; requires `pip install -e ".[semantic]"`.
# The deterministic matcher (exact/alias/adjacent/lexical) works unchanged
# with this off, which is the supported default.
SEMANTIC_MATCHING_ENABLED=false
SEMANTIC_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
SEMANTIC_SIMILARITY_THRESHOLD=0.72

# --- Execution (Blueprint Phases 6-7) ---

# The MOCK executor never touches the network; only for tests / demos.
EXECUTION_MOCK_ENABLED=false
EXECUTION_MAX_ATTEMPTS=3
EXECUTION_LEASE_SECONDS=900
# Real local documents the local browser may upload for file fields. Phase 4
# artifacts are text and nothing is rendered automatically: without these a
# required upload hands the application to you (ARTIFACT_FILE_REQUIRED).
EXECUTION_RESUME_FILE=
EXECUTION_COVER_LETTER_FILE=

# Local Playwright executor (`pip install -e ".[browser]" && playwright install chromium`).
# Dry-run is the default: navigate, inspect, map, report - never press submit.
PLAYWRIGHT_DRY_RUN=true
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_NAVIGATION_TIMEOUT_MS=30000
PLAYWRIGHT_ACTION_TIMEOUT_MS=10000
PLAYWRIGHT_SUBMIT_WAIT_MS=15000
# After the load event, keep re-scanning (main frame, then embedded ATS frames)
# for up to this long while a page renders its form client-side (Phase 13).
PLAYWRIGHT_SETTLE_MS=8000
PLAYWRIGHT_MIN_DELAY_SECONDS=2.0
# Optional persistent LOCAL browser profile (cookies, signed-in sessions).
# Keep it out of git and backups; it is never read by the server. Example:
# PLAYWRIGHT_PROFILE_DIR=data/browser_profile
PLAYWRIGHT_PROFILE_DIR=
# With a visible browser (PLAYWRIGHT_HEADLESS=false), wait this many seconds
# for you to clear a CAPTCHA / login / MFA yourself before handing off.
PLAYWRIGHT_HANDOFF_WAIT_SECONDS=0
# Opt-in local folder for handoff screenshots (may contain your data). Empty = off.
PLAYWRIGHT_DEBUG_ARTIFACTS_DIR=
EXECUTION_WORKER_CONCURRENCY=1
EXECUTION_WORKER_POLL_SECONDS=5
# Desktop shell local state (the notification cursor file). Git-ignored.
# DESKTOP_STATE_DIR=.cache/desktop

# --- Documents (Blueprint Phase 8) ---
# Rendered PDF/DOCX resumes and cover letters: local files only (git-ignored),
# immutable per version, SHA-256 verified before every upload. No AI.
DOCUMENTS_ROOT=data/documents
# Optional TrueType font for glyphs outside Latin-1 (embedded only when needed).
DOCUMENTS_FONT_PATH=
DOCUMENTS_MAX_PAGES_RESUME=4
DOCUMENTS_MAX_PAGES_COVER_LETTER=2
DOCUMENTS_MAX_BYTES=5242880
# Optional fixed date line on cover letters (ISO date); empty = no date line.
DOCUMENTS_LETTER_DATE=

# --- Browser extension (Blueprint Phase 9) ---
# Nothing to configure here: the extension (extension/, load unpacked) keeps
# the server address, this API_KEY and its submit mode in its own browser
# storage (Options page). It reaches the API on http://127.0.0.1 / localhost
# only, from a chrome-extension:// or moz-extension:// origin (CORS-allowed
# in app/main.py). EXECUTION_LEASE_SECONDS is the lease it heartbeats.
