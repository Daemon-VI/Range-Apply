# CareerOS Configuration

# Application
APP_NAME=CareerOS
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000

# Database (SQLite for dev; PostgreSQL for production)
DATABASE_URL=sqlite:///./careeros.db
# DATABASE_URL=postgresql://user:password@localhost:5432/careeros

# Career data seed file path (relative to project root)
CAREER_DATA_PATH=data/career_seed.json

# --- Phase 2: Job Discovery ---

# Firecrawl (optional — keyless mode works with IP-based rate limits)
# FIRECRAWL_API_KEY=fc-your-api-key-here

# Firecrawl rate limit (requests per minute)
FIRECRAWL_RATE_LIMIT=5

# LLM provider for extraction fallback: "stub" (offline) or "gemini"
LLM_PROVIDER=stub

# Gemini API key (required only if LLM_PROVIDER=gemini)
# GEMINI_API_KEY=your-gemini-api-key-here

# Discovery pipeline
DEFAULT_DISCOVERY_CONCURRENCY=3
MAX_RETRIES=3
RETRY_BACKOFF_BASE=2.0
